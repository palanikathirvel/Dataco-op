# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-nextauth-secret-change-this-in-production"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Razorpay
RAZORPAY_KEY_ID="your_razorpay_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your_razorpay_key_id"
# For payouts (RazorpayX)
RAZORPAYX_KEY_ID="your_razorpayx_key_id"
RAZORPAYX_KEY_SECRET="your_razorpayx_key_secret"

# Resend (for email)
RESEND_API_KEY="your_resend_api_key"
FROM_EMAIL="onboarding@datacoop.in"

# Supabase Storage (if using)
SUPABASE_URL="your_supabase_url"
SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key"

# Other
NODE_ENV="development"
PORT="3000"